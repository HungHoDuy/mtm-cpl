  "project": {
    "name": "Actual Budget",
    "summary": "Actual Budget is an open-source, local-first personal finance app based on envelope budgeting. It runs in the browser against a local database and syncs through an optional server.",
    "features": [
      "Accounts: on-budget and off-budget accounts, transfers between them with linked counterparts, reconciliation",
      "Envelope budget: monthly budgeted, spent and balance per category, carry-over, To Budget",
      "Bank file import: OFX, QIF, CSV and CAMT statements with matching against existing transactions",
      "Rules: conditions and actions that set payees, categories, notes and splits, including percent splits and templates",
      "Schedules: recurring and one-off scheduled transactions with upcoming, due, missed and paid states",
      "Payees: payee management, merging and unused-payee cleanup"
    ]
  },
